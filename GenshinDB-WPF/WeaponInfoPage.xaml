<Page x:Class="GenshinDB_WPF.WeaponInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GenshinDB_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="682" d:DesignWidth="1190"
      Title="WeaponInfoPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="895*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="109*"/>
            <RowDefinition Height="118*"/>
            <RowDefinition Height="117*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="78*"/>
            <RowDefinition Height="84*"/>
            <RowDefinition Height="84*"/>
        </Grid.RowDefinitions>
        <Rectangle Stroke="White" Fill="White" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="3" Grid.RowSpan="7">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <ComboBox x:Name="WeaponDropdown" Margin="5" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Weapons" SelectionChanged="WeaponDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <ComboBox x:Name="WeaponLevelDropdown" Margin="5" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Level" SelectionChanged="WeaponLevelDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Button x:Name="WeaponRefinementButton" Content="Refinements" Margin="5" Grid.Row="3" Grid.Column="0" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Click="WeaponRefinementButton_Click"/>
        <Button x:Name="WeaponInfoButton" Content="Info" Margin="5" Grid.Row="4" Grid.Column="0" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Click="WeaponInfoButton_Click"/>
        <Button x:Name="WeaponStatsButton" Content="Stats" Margin="5" Grid.Row="5" Grid.Column="0" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Click="WeaponStatsButton_Click"/>
        <TextBlock x:Name="WeaponText" TextWrapping="Wrap" Grid.Column="2" Grid.RowSpan="7" FontSize="20"/>
    </Grid>
</Page>
