<Page x:Class="GenshinDB_WPF.ArtifactInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GenshinDB_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="682" d:DesignWidth="1190"
      Title="ArtifactInfoPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212*"/>
            <ColumnDefinition Width="82*"/>
            <ColumnDefinition Width="895*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="97*"/>
            <RowDefinition Height="105*"/>
            <RowDefinition Height="104*"/>
            <RowDefinition Height="128*"/>
            <RowDefinition Height="83*"/>
            <RowDefinition Height="82*"/>
            <RowDefinition Height="83*"/>
        </Grid.RowDefinitions>
        <Rectangle Stroke="White" Fill="White" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="3" Grid.RowSpan="7">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <ComboBox x:Name="ArtifactDropdown" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Artifact Sets" SelectionChanged="ArtifactDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True" Margin="5,5,5,5">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Viewbox StretchDirection="DownOnly" Grid.ColumnSpan="1" Grid.Row="0" Grid.RowSpan="7" Grid.Column="2">
            <TextBlock Width="850" x:Name="ArtifactText" VerticalAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap" />
        </Viewbox>
        <ComboBox x:Name="ArtifactStatsDropdown" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,5" Text="Type" SelectionChanged="ArtifactStatsDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <ComboBox x:Name="ArtifactRarityDropdown" Grid.Row="2" Grid.Column="0" Margin="5,5,5,5" Grid.ColumnSpan="2" Text="Rarity" SelectionChanged="ArtifactRarityDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Button x:Name="ArtifactInfoButton" Content="Info" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Click="ArtifactInfoButton_Click" Margin="5,5,5,5" Grid.Row="4"/>
        <Button x:Name="ArtifactStatsButton" Content="Stats" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Click="ArtifactStatsButton_Click" Margin="5,5,5,5" Grid.Row="5"/>

    </Grid>
</Page>
