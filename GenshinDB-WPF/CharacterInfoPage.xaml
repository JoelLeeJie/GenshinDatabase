<Page x:Class="GenshinDB_WPF.CharacterInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GenshinDB_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="682" d:DesignWidth="1190"
      Title="CharacterInfoPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="895*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="109*"/>
            <RowDefinition Height="118*"/>
            <RowDefinition Height="117*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="78*"/>
            <RowDefinition Height="84*"/>
            <RowDefinition Height="84*"/>
        </Grid.RowDefinitions>
        <Rectangle Stroke="White" Fill="White" RenderTransformOrigin="0.5,0.5" Margin="-1,0,-1,-8" Grid.ColumnSpan="3" Grid.RowSpan="7">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <ComboBox x:Name="CharacterDropdown" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,5" Text="Characters" SelectionChanged="CharacterDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <ComboBox x:Name="CharacterLevelDropdown" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,5" Text="Level" SelectionChanged="CharacterLevelDropdown_SelectionChanged" BorderBrush="#FF0563CA" Foreground="#FF2666EF" IsEditable="True" IsReadOnly="True">
            <ComboBox.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF1B50D2" Offset="1"/>
                </LinearGradientBrush>
            </ComboBox.Background>
        </ComboBox>
        <Viewbox StretchDirection="DownOnly" Grid.ColumnSpan="1" Grid.Row="0" Grid.RowSpan="7" Grid.Column="2">
            <TextBlock Width="850" x:Name="CharacterText" VerticalAlignment="Top" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </Viewbox>
        <Button x:Name="CharacterConstellationButton" Content="Constellations" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Grid.Row="3" Margin ="5,5,5,5" Grid.Column="0" Click="CharacterConstellationButton_Click"/>
        <Button x:Name="CharacterInfoButton" Content="Info"  BorderBrush="#FFBB1515" Background="#FFC5FFC6" Grid.Row="4" Grid.Column="0" Margin ="5,5,5,5" Click="CharacterInfoButton_Click"/>
        <Button x:Name="CharacterStatsButton" Content="Stats" BorderBrush="#FFBB1515" Background="#FFC5FFC6" Grid.Row="5" Grid.Column="0" Margin ="5,5,5,5" Click="CharacterStatsButton_Click"/>
    </Grid>
</Page>
