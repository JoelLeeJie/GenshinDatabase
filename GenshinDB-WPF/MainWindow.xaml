<Window x:Class="GenshinDB_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GenshinDB_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="675" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68*"/>
            <RowDefinition Height="455*"/>
            <RowDefinition Height="121*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>
        <TextBox Margin="5,5,5,5" TextWrapping="Wrap" Text="GenshinDB" FontSize="20" TextAlignment="Center" Grid.Row="0"/>
        <Frame x:Name="PageFrame" Grid.Column="0" Grid.ColumnSpan="3" NavigationUIVisibility="Hidden" Grid.Row="1"/>
        <Button x:Name="Character" Content="Character" Grid.Column="0" Grid.Row="2" Background="#FFD6E8FF" RenderTransformOrigin="0.5,0.5" Click="Character_Click" Margin="15,15,15,15"/>
        <Button x:Name="Weapon" Content="Weapon" Grid.Column="1" Background="#FFD6E8FF" Click="Weapon_Click" Margin="15,15,15,15" Grid.Row="2"/>
        <Button x:Name="Artifact" Content="Artifact" Grid.Column="2" Grid.Row="2" Background="#FFD6E8FF" Click="Artifact_Click" Margin="15,15,15,15"/>
    </Grid>
</Window>
